<view class="container">
  <!-- 宝宝陪伴卡 -->
  <view class="card baby-card">
    <block wx:if="{{babyBirthDate}}">
      <view class="baby-header">
        <text class="baby-emoji">👶</text>
        <view class="baby-info">
          <view class="baby-days-row">
            宝宝已经呱呱坠地 <text class="baby-days">{{babyDays}}</text> 天了
          </view>
          <view class="baby-meta">{{babyAgeText}} · {{babyBirthDate}}</view>
        </view>
        <picker mode="date" value="{{babyBirthDate}}" end="{{todayDate}}" bindchange="onBirthDateChange">
          <text class="baby-edit">✎</text>
        </picker>
      </view>
      <view wx:if="{{babyMilestone}}" class="baby-milestone">{{babyMilestone}}</view>
    </block>
    <picker wx:else mode="date" end="{{todayDate}}" bindchange="onBirthDateChange">
      <view class="baby-empty">
        <text class="baby-emoji">👶</text>
        <view>
          <view class="baby-empty-title">点击设置宝宝生日</view>
          <view class="baby-empty-sub">每天看看宝宝的天数与月龄</view>
        </view>
      </view>
    </picker>
  </view>

  <view class="card cry-alert-card">
    <view>
      <view class="cry-alert-title">哭声提醒</view>
      <view class="cry-alert-desc">授权后，树莓派检测到持续哭声会向本微信发送通知</view>
    </view>
    <button class="cry-alert-btn" bindtap="enableCryAlert">开启提醒</button>
  </view>

  <!-- 日期汇总 -->
  <view class="card summary-card">
    <view class="summary-header">
      <view class="summary-title">{{currentDate === todayDate ? '今日' : currentDate}} 汇总</view>
      <view class="date-actions">
        <view wx:if="{{currentDate !== todayDate}}" class="today-btn" bindtap="goToday">今天</view>
        <picker mode="date" value="{{currentDate}}" end="{{todayDate}}" bindchange="bindDateChange">
          <view class="date-picker">📅 切换日期</view>
        </picker>
      </view>
    </view>
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-num">{{todayStats.count}}</view>
        <view class="summary-label">喂养次数</view>
      </view>
      <view class="summary-item">
        <view class="summary-num">{{todayStats.total}}</view>
        <view class="summary-label">总奶量(ml)</view>
      </view>
      <view class="summary-item">
        <view class="summary-num">{{todayStats.breast}}</view>
        <view class="summary-label">母乳(ml)</view>
      </view>
      <view class="summary-item">
        <view class="summary-num">{{todayStats.formula}}</view>
        <view class="summary-label">奶粉(ml)</view>
      </view>
    </view>
    <view class="summary-ratio">
      母乳占比：<text class="ratio-num">{{todayStats.ratio}}</text>
      <text class="stool-info">，大便 {{todayStats.stool}} 次</text>
    </view>
  </view>

  <!-- 快速录入（仅在查看今日时显示） -->
  <view wx:if="{{currentDate === todayDate}}" class="card feeding-settings-card">
    <view>
      <view class="feeding-settings-title">下次喂养参考</view>
      <view class="feeding-settings-desc">{{feedingRecommendationText}}</view>
      <view class="feeding-period-row">
        <view class="feeding-period-item">
          <text>☀️ 白天 07–19</text>
          <text class="feeding-period-value">{{feedingPeriodRecommendations.daytime.minutes / 60}} 小时</text>
          <text class="feeding-period-sample">{{feedingPeriodRecommendations.daytime.usingDefault ? '样本不足，暂用默认' : '样本 ' + feedingPeriodRecommendations.daytime.sampleCount + ' 段'}}</text>
        </view>
        <view class="feeding-period-item">
          <text>🌙 夜间 19–07</text>
          <text class="feeding-period-value">{{feedingPeriodRecommendations.nighttime.minutes / 60}} 小时</text>
          <text class="feeding-period-sample">{{feedingPeriodRecommendations.nighttime.usingDefault ? '样本不足，暂用默认' : '样本 ' + feedingPeriodRecommendations.nighttime.sampleCount + ' 段'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{feedingIntervalReminder.visible}}" class="card feeding-reminder-card">
    <view class="feeding-reminder-icon">⏰</view>
    <view>
      <view class="feeding-reminder-title">距上次已 {{sinceLastFeedingText}}</view>
      <view class="feeding-reminder-desc">{{feedingIntervalReminder.text}}</view>
    </view>
  </view>

  <view wx:if="{{dailyReview.visible}}" class="card daily-review-card">
    <view class="daily-review-title">🌙 昨日记录审查</view>
    <view class="daily-review-desc">{{dailyReview.date}}：{{dailyReview.feedingCount}} 次，共 {{dailyReview.totalMilk}}ml</view>
    <view wx:if="{{dailyReview.closePairCount > 0}}" class="daily-review-warning">
      发现 {{dailyReview.closePairCount}} 组 1 小时内的记录，请点开下方记录确认是否重复。
    </view>
    <view wx:else class="daily-review-ok">未发现 1 小时内的疑似重复记录。</view>
    <button class="daily-review-confirm" bindtap="confirmDailyReview">已核对</button>
  </view>

  <view wx:if="{{currentDate === todayDate}}" class="card quick-card">
    <view class="quick-title">⚡ 快速录入（当前时间）</view>
    <view class="quick-row">
      <input class="quick-input" type="digit" placeholder="母乳 ml" value="{{quickBreast}}" bindinput="onQuickBreast" />
      <input class="quick-input" type="digit" placeholder="奶粉 ml" value="{{quickFormula}}" bindinput="onQuickFormula" />
      <button class="quick-btn" disabled="{{quickSaving}}" bindtap="quickSave">保存</button>
    </view>
  </view>

  <!-- 当日记录列表 -->
  <view class="card">
    <view class="list-header">
      <text class="list-title">{{currentDate === todayDate ? '今日' : currentDate}} 记录</text>
      <view class="list-header-right">
        <text wx:if="{{currentDate === todayDate && sinceLastFeedingText}}" class="since-pill">⏱ 距上次 {{sinceLastFeedingText}}</text>
        <text class="list-count">{{records.length}} 条</text>
      </view>
    </view>

    <block wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}">
        <view class="record-icon {{item.icons.length > 1 ? 'record-icon-multi' : ''}}">
          <text wx:for="{{item.icons}}" wx:for-item="icon" wx:key="*this">{{icon}}</text>
        </view>
        <view class="record-left">
          <view class="record-time">{{item.time}}</view>
          <view class="record-interval" wx:if="{{item.intervalText}}">距上次 {{item.intervalText}}</view>
          <view class="record-desc" wx:if="{{item.stool}}">💩 {{item.stoolDesc || '大便'}}</view>
          <view class="record-desc solid-food-desc" wx:if="{{item.solidFood}}">🍚 {{item.solidFoodDishName || '辅食'}} {{item.solidFoodGrams}}g</view>
        </view>
        <view class="record-right">
          <view class="record-right-inner">
            <view class="milk-tags">
              <text class="tag breast-tag" wx:if="{{item.breastMilk > 0}}">母乳 {{item.breastMilk}}</text>
              <text class="tag formula-tag" wx:if="{{item.formula > 0}}">奶粉 {{item.formula}}</text>
            </view>
            <view class="record-total">{{item.total}}ml</view>
          </view>
          <text class="record-arrow">›</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty-tip">
      <text class="empty-emoji">🍼</text>
      {{currentDate === todayDate ? '今天还没有喂养记录哦' : currentDate + '没有记录'}}
      <view class="empty-sub">下方按钮一键记下来吧～</view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view wx:if="{{currentDate === todayDate && supplementReminder.visible}}" class="card supplement-card">
    <view class="supplement-left">
      <view class="supplement-icon">☀️</view>
      <view class="supplement-copy">
        <view class="supplement-title">{{supplementReminder.title}}</view>
      </view>
    </view>
    <view class="supplement-right">
      <view class="supplement-status {{supplementReminder.taken ? 'taken' : ''}}">{{supplementReminder.statusText}}</view>
      <button wx:if="{{supplementReminder.name}}" class="supplement-btn {{supplementReminder.taken ? 'taken' : ''}}" bindtap="toggleSupplementTaken">
        {{supplementReminder.actionText}}
      </button>
    </view>
  </view>

  <button class="btn-primary" bindtap="goAdd">🍼 添加详细记录</button>
  <button class="btn-secondary" bindtap="goBatch">📋 批量补录历史数据</button>
</view>
