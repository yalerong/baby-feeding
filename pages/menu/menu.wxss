.hero-card {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.hero-visual {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: rgba(255, 255, 255, 0.22);
  text-align: center;
  line-height: 110rpx;
  font-size: 58rpx;
}

.stage-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  opacity: 0.95;
}

.view-toggle {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(91, 197, 143, 0.10);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 18rpx;
}

.toggle-item.active {
  color: #fff;
  font-weight: 600;
  background: #5BC58F;
}

.milk-title,
.caution-title,
.day-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.notice-card {
  background: #FFF8E8;
  border: 1rpx solid #FFE3A3;
  box-shadow: none;
}

.notice-title {
  font-size: 30rpx;
  color: #A86300;
  font-weight: 600;
}

.notice-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7A5B24;
  line-height: 1.5;
}

.milk-text,
.caution-line {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
}

.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  color: #5BC58F;
  font-size: 54rpx;
}

.week-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.day-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.day-tab {
  flex: 0 0 92rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(91, 197, 143, 0.08);
}

.day-tab.active {
  background: #5BC58F;
  color: #fff;
}

.day-tab-week {
  font-size: 24rpx;
  font-weight: 600;
}

.day-tab-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.list-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.list-count {
  color: #999;
  font-size: 24rpx;
}

.dirty-tip {
  color: #E65100;
  background: #FFF1E0;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nutrition-tag,
.mini-tag {
  background: #F1F8F4;
  color: #2E8753;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
}

.meal-row {
  display: flex;
  padding-top: 22rpx;
}

.meal-label {
  width: 82rpx;
  color: #5BC58F;
  font-size: 26rpx;
  font-weight: 600;
  padding-top: 18rpx;
}

.dish-list {
  flex: 1;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #FFFCF7;
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.dish-art {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  line-height: 82rpx;
  text-align: center;
  font-size: 42rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.dish-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.dish-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #999;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.replace-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: #5BC58F;
  background: #EAF8F0;
  border-radius: 28rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.hall-head {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.hall-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hall-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hall-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.hall-close {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 26rpx;
}

.dish-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.dish-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.current-tag {
  background: #EAF8F0;
  color: #2E8753;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
}

.dish-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.select-arrow {
  color: #ccc;
  font-size: 44rpx;
  margin-left: 10rpx;
}

.catalog-note {
  color: #777;
  font-size: 25rpx;
  line-height: 1.55;
}

.catalog-entry {
  border: 1rpx solid #C6EDD4;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.catalog-hero {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.catalog-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.catalog-title {
  font-size: 40rpx;
  font-weight: 700;
}

.catalog-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.filter-panel {
  padding-bottom: 18rpx;
}

.filter-title {
  color: #333;
  font-size: 27rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.filter-title:first-child {
  margin-top: 0;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-chip {
  color: #666;
  background: #F7F7F7;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
}

.filter-chip.active {
  color: #fff;
  background: #5BC58F;
}

.catalog-item {
  padding: 24rpx;
}

.catalog-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.catalog-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.catalog-section {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid #FFFAF5;
}

.catalog-section.caution {
  color: #8A5A00;
}

.catalog-label {
  flex-shrink: 0;
  width: 74rpx;
  color: #5BC58F;
  font-size: 25rpx;
  font-weight: 600;
}

.catalog-text,
.catalog-lines {
  flex: 1;
  color: #666;
  font-size: 25rpx;
  line-height: 1.55;
}

.month-picker-card {
  padding: 24rpx 30rpx;
}

.month-picker {
  color: #5BC58F;
  font-size: 30rpx;
  font-weight: 600;
}

.month-week {
  padding: 28rpx 32rpx;
}

.month-week-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.month-week-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.month-week-date,
.month-stage,
.month-preview {
  font-size: 26rpx;
  color: #888;
}

.month-stage {
  margin-top: 12rpx;
}

.month-preview {
  margin-top: 10rpx;
  color: #5BC58F;
}
