.hero-card {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.hero-visual {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: rgba(255, 255, 255, 0.22);
  text-align: center;
  line-height: 110rpx;
  font-size: 58rpx;
}

.stage-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  opacity: 0.95;
}

.view-toggle {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(91, 197, 143, 0.10);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 18rpx;
}

.toggle-item.active {
  color: #fff;
  font-weight: 600;
  background: #5BC58F;
}

.milk-title,
.caution-title,
.day-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.notice-card {
  background: #FFF8E8;
  border: 1rpx solid #FFE3A3;
  box-shadow: none;
}

.notice-title {
  font-size: 30rpx;
  color: #A86300;
  font-weight: 600;
}

.notice-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7A5B24;
  line-height: 1.5;
}

.milk-text,
.caution-line {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
}

.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  color: #5BC58F;
  font-size: 54rpx;
}

.week-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.day-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.day-tab {
  flex: 0 0 92rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(91, 197, 143, 0.08);
}

.day-tab.active {
  background: #5BC58F;
  color: #fff;
}

.day-tab-week {
  font-size: 24rpx;
  font-weight: 600;
}

.day-tab-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.list-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.list-count {
  color: #999;
  font-size: 24rpx;
}

.dirty-tip {
  color: #E65100;
  background: #FFF1E0;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nutrition-tag,
.mini-tag {
  background: #F1F8F4;
  color: #2E8753;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
}

.meal-row {
  display: flex;
  padding-top: 22rpx;
}

.meal-label {
  width: 82rpx;
  color: #5BC58F;
  font-size: 26rpx;
  font-weight: 600;
  padding-top: 18rpx;
}

.dish-list {
  flex: 1;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #FFFCF7;
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.trial-hero {
  background: linear-gradient(135deg, #F1FBF4 0%, #FFF5D9 100%);
}

.trial-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.trial-score {
  min-width: 104rpx;
  padding: 12rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #8A7864;
  font-size: 20rpx;
  text-align: center;
}

.trial-score-number {
  color: #E49A2D;
  font-size: 40rpx;
  font-weight: 700;
}

.trial-title {
  font-size: 32rpx;
  color: #2E8753;
  font-weight: 700;
}

.trial-desc,
.trial-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6F7D72;
}

.trial-active {
  display: inline-block;
  margin-top: 16rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  background: #DDF3E6;
  color: #2E8753;
  font-size: 24rpx;
}

.trial-note {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: #FFF8E7;
  color: #936F30;
}

.trial-service-error {
  margin: 18rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #FFF1EF;
  color: #C94F49;
  font-size: 23rpx;
  line-height: 1.45;
}

.trial-food {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.trial-food-allergic {
  border: 2rpx solid #F2BBB6;
  background: #FFF6F5;
}

.trial-food-allergic .trial-food-icon {
  background: #FFE5E2;
}

.trial-food-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.trial-food-icon {
  width: 66rpx;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #FFF3D6;
  font-size: 36rpx;
  flex-shrink: 0;
}

.trial-food-name {
  margin-left: 14rpx;
  font-size: 29rpx;
  color: #333;
  font-weight: 600;
}

.trial-category {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #719778;
}

.allergen-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 400;
}

.allergen-tag.observe { background: #EEF6ED; color: #668B69; }
.allergen-tag.common-allergen { background: #FFF0E6; color: #C35D39; }

.trial-food-status {
  margin: 6rpx 0 0 14rpx;
  font-size: 22rpx;
  color: #B77723;
}

.trial-food-status.unlocked { color: #2E8753; }
.trial-food-status.allergic { color: #D9534F; }

.allergen-hint {
  margin: 4rpx 0 0 14rpx;
  font-size: 20rpx;
  color: #9B9288;
}

.trial-food-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.trial-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}

.trial-step {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border: 2rpx solid #C8D8CE;
  border-radius: 50%;
  color: #A4B3A8;
  font-size: 21rpx;
  text-align: center;
}

.trial-step.done {
  border-color: #58BE88;
  background: #EDFAF2;
  color: #38A66E;
}

.trial-step.current {
  box-shadow: 0 0 0 5rpx rgba(88, 190, 136, 0.16);
}

.trial-log-btn,
.trial-alert-btn,
.trial-undo-btn,
.trial-restore-btn,
.trial-remove-btn {
  margin: 0;
  padding: 0 14rpx;
  min-width: 122rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
}

.trial-action {
  box-sizing: border-box;
  text-align: center;
}

.trial-log-btn { background: #5BC58F; color: #fff; }
.trial-alert-btn { background: #FFF1E9; color: #C45D43; }
.trial-undo-btn { background: #FFF1EF; color: #C94F49; }
.trial-restore-btn { background: #EAF3FF; color: #3B74AE; }

.trial-log-btn::after,
.trial-alert-btn::after,
.trial-undo-btn::after,
.trial-restore-btn::after { border: none; }

.dish-art {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  line-height: 82rpx;
  text-align: center;
  font-size: 42rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.dish-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.dish-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #999;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.replace-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: #5BC58F;
  background: #EAF8F0;
  border-radius: 28rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.hall-head {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.hall-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hall-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hall-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.hall-close {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 26rpx;
}

.dish-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.dish-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.current-tag {
  background: #EAF8F0;
  color: #2E8753;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
}

.dish-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.select-arrow {
  color: #ccc;
  font-size: 44rpx;
  margin-left: 10rpx;
}

.catalog-note {
  color: #777;
  font-size: 25rpx;
  line-height: 1.55;
}

.catalog-entry {
  border: 1rpx solid #C6EDD4;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.catalog-hero {
  background: linear-gradient(135deg, #5BC58F 0%, #8AD8AE 100%);
  color: #fff;
}

.catalog-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.catalog-title {
  font-size: 40rpx;
  font-weight: 700;
}

.catalog-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.filter-panel {
  padding-bottom: 18rpx;
}

.filter-title {
  color: #333;
  font-size: 27rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.filter-title:first-child {
  margin-top: 0;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-chip {
  color: #666;
  background: #F7F7F7;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
}

.filter-chip.active {
  color: #fff;
  background: #5BC58F;
}

.catalog-item {
  padding: 24rpx;
}

.catalog-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.catalog-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.catalog-section {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-top: 1rpx solid #FFFAF5;
}

.catalog-section.caution {
  color: #8A5A00;
}

.catalog-label {
  flex-shrink: 0;
  width: 74rpx;
  color: #5BC58F;
  font-size: 25rpx;
  font-weight: 600;
}

.catalog-text,
.catalog-lines {
  flex: 1;
  color: #666;
  font-size: 25rpx;
  line-height: 1.55;
}

.guide-card {
  padding: 24rpx 30rpx;
}

.guide-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.guide-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #333;
}

.guide-actions {
  display: flex;
  align-items: center;
}

.guide-move {
  font-size: 24rpx;
  color: #5BC58F;
  padding: 4rpx 12rpx;
}

.guide-close {
  padding: 4rpx 16rpx;
  color: #bbb;
  font-size: 30rpx;
}

.guide-step {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 8rpx;
}

.phase-tip-card {
  padding: 22rpx 30rpx;
  font-size: 26rpx;
  color: #8A6D3B;
  background: #FFF8E6;
  line-height: 1.55;
}

.phase-tip {
  margin: 12rpx 0 4rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #5BC58F;
  background: #F0FAF5;
  border-radius: 16rpx;
  line-height: 1.55;
}

.month-picker-card {
  padding: 24rpx 30rpx;
}

.month-picker {
  color: #5BC58F;
  font-size: 30rpx;
  font-weight: 600;
}

.month-week {
  padding: 28rpx 32rpx;
}

.month-week-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.month-week-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.month-week-date,
.month-stage,
.month-preview {
  font-size: 26rpx;
  color: #888;
}

.month-stage {
  margin-top: 12rpx;
}

.month-preview {
  margin-top: 10rpx;
  color: #5BC58F;
}

.custom-food-card {
  padding: 24rpx 28rpx;
}

.custom-food-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E8753;
  margin-bottom: 14rpx;
}

.custom-food-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.custom-food-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #F6F5F1;
  font-size: 28rpx;
}

.custom-food-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 18rpx;
  background: #5BC58F;
  color: #fff;
  font-size: 28rpx;
}

.custom-food-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8C8578;
  line-height: 1.5;
}

.custom-dish-option {
  border: 2rpx dashed #BFD9C8;
}

.trial-remove-btn {
  background: #F3F0EA;
  color: #8C8578;
}

.allergy-note {
  margin-top: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #FDECEC;
  color: #B4423C;
  font-size: 22rpx;
  line-height: 1.5;
}
