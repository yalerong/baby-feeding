<view class="container">
  <view class="card form-card">
    <view wx:if="{{!isEdit && latestFeeding}}" class="latest-feeding-tip">
      上次记录：{{latestFeeding.time}}，{{latestFeeding.breastMilk + latestFeeding.formula}}ml。本页填写的是本次新增奶量。
    </view>
    <view class="form-item">
      <view class="form-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="bindDateChange">
        <view class="picker-value">{{date}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">时间</view>
      <picker mode="time" value="{{time}}" bindchange="bindTimeChange">
        <view class="picker-value">{{time}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">母乳 (ml)</view>
      <input type="digit" value="{{breastMilk}}" bindinput="bindBreastInput" placeholder="0" />
    </view>

    <view class="form-item">
      <view class="form-label">奶粉 (ml)</view>
      <input type="digit" value="{{formula}}" bindinput="bindFormulaInput" placeholder="0" />
    </view>

    <view class="form-section-divider"></view>

    <view class="form-item">
      <view class="form-label">有大便</view>
      <switch checked="{{stool}}" bindchange="bindStoolChange" color="#5BC58F" />
    </view>

    <block wx:if="{{stool}}">
      <view class="form-item">
        <view class="form-label">性状</view>
        <picker bindchange="bindStoolTextureChange" value="{{stoolTextureIndex}}" range="{{stoolTextures}}">
          <view class="picker-value {{stoolTextureIndex === -1 ? 'placeholder' : ''}}">{{stoolTextureIndex !== -1 ? stoolTextures[stoolTextureIndex] : '请选择'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">颜色</view>
        <picker bindchange="bindStoolColorChange" value="{{stoolColorIndex}}" range="{{stoolColors}}">
          <view class="picker-value {{stoolColorIndex === -1 ? 'placeholder' : ''}}">{{stoolColorIndex !== -1 ? stoolColors[stoolColorIndex] : '请选择'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">量</view>
        <picker bindchange="bindStoolAmountChange" value="{{stoolAmountIndex}}" range="{{stoolAmounts}}">
          <view class="picker-value {{stoolAmountIndex === -1 ? 'placeholder' : ''}}">{{stoolAmountIndex !== -1 ? stoolAmounts[stoolAmountIndex] : '请选择'}}</view>
        </picker>
      </view>
    </block>

    <view class="form-section-divider"></view>

    <view class="form-item">
      <view class="form-label">🍚 辅食</view>
      <switch checked="{{solidFood}}" bindchange="bindSolidFoodChange" color="#5BC58F" />
    </view>

    <block wx:if="{{solidFood}}">
      <view class="solid-food-choices">
        <view class="solid-food-choices-title">当前月龄常吃</view>
        <view class="solid-food-choice-list">
          <view wx:for="{{solidFoodFrequentDishes}}" wx:key="name" class="solid-food-choice {{(item.id ? solidFoodDishId === item.id : solidFoodName === item.name) ? 'active' : ''}}" data-dish-id="{{item.id}}" data-name="{{item.name}}" data-foods="{{item.foods}}" bindtap="selectFrequentSolidFood">
            {{item.imageEmoji}} {{item.name}}
          </view>
        </view>
        <view class="solid-food-choice-hint">没在这里？直接填写下面的“其他辅食”即可，写上食材名（如 胡萝卜泥）会自动记试吃</view>
      </view>
      <view class="solid-food-reused-tip" wx:if="{{solidFoodReused}}">已沿用上次：{{solidFoodName}} {{solidFoodGrams}}g，改动任一项即取消</view>
      <view class="form-item">
        <view class="form-label">其他辅食</view>
        <input value="{{solidFoodCustomName}}" bindinput="bindSolidFoodCustomNameInput" placeholder="例如：自制番薯泥" />
      </view>
      <view class="form-item">
        <view class="form-label">辅食克数 (g)</view>
        <input type="digit" value="{{solidFoodGrams}}" bindinput="bindSolidFoodGramsInput" placeholder="0" />
      </view>
      <view class="solid-food-presets">
        <text class="solid-food-presets-label">常用克数</text>
        <view class="solid-food-preset-list">
          <view wx:for="{{solidFoodGramPresets}}" wx:key="*this" class="solid-food-preset {{solidFoodGrams == item ? 'active' : ''}}" data-grams="{{item}}" bindtap="useSolidFoodGramPreset">{{item}}g</view>
        </view>
      </view>
    </block>
  </view>

  <view class="preview-card card" wx:if="{{breastMilk > 0 || formula > 0}}">
    <view class="preview-title">本次录入预览</view>
    <view class="preview-content">
      <text wx:if="{{breastMilk > 0}}">母乳 {{breastMilk}}ml </text>
      <text wx:if="{{formula > 0}}">奶粉 {{formula}}ml </text>
      <text>，合计 {{total}}ml</text>
      <text wx:if="{{solidFood}}">；🍚 {{solidFoodName || '未填写辅食'}} {{solidFoodGrams || 0}}g</text>
    </view>
  </view>

  <view class="preview-card card solid-food-preview" wx:if="{{solidFood && breastMilk <= 0 && formula <= 0}}">
    <view class="preview-title">本次录入预览</view>
    <view class="preview-content">🍚 {{solidFoodName || '未填写辅食'}} {{solidFoodGrams || 0}}g</view>
  </view>

  <button class="btn-primary" disabled="{{saving}}" bindtap="submit">{{saving ? '保存中...' : (isEdit ? '保存修改' : '保存记录')}}</button>
  <button wx:if="{{isEdit}}" class="btn-danger" bindtap="deleteRecord">删除记录</button>
  <button class="btn-secondary" bindtap="goBack">取消</button>
</view>
