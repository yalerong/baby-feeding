.form-card {
  padding: 10rpx 30rpx;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-section-divider {
  height: 14rpx;
  margin: 0 -30rpx;
  background: #F4F7F5;
  border-top: 1rpx solid #DCE9E1;
  border-bottom: 1rpx solid #DCE9E1;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
  width: 160rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #5BC58F;
  text-align: right;
  min-width: 200rpx;
}

.picker-value.placeholder {
  color: #bbb;
}

input {
  font-size: 30rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.preview-card {
  background: #C6EDD4;
}

.solid-food-preview {
  background: #FFF3DE;
}

.solid-food-choices {
  padding: 24rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.solid-food-choices-title {
  color: #8A7864;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.solid-food-choice-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.solid-food-choice {
  box-sizing: border-box;
  width: calc(50% - 6rpx);
  padding: 16rpx 14rpx;
  border: 1rpx solid #F0DEC1;
  border-radius: 12rpx;
  background: #FFF9F0;
  color: #705C43;
  font-size: 25rpx;
  line-height: 1.35;
}

.solid-food-choice.active {
  border-color: #E8A847;
  background: #FFF0D4;
  color: #9A6219;
  font-weight: 500;
}

.solid-food-choice-hint {
  margin-top: 16rpx;
  color: #A89B8B;
  font-size: 22rpx;
}

.solid-food-presets {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0 22rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.solid-food-presets-label {
  flex-shrink: 0;
  color: #8A7864;
  font-size: 24rpx;
}

.solid-food-preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.solid-food-preset {
  min-width: 62rpx;
  padding: 6rpx 10rpx;
  border-radius: 18rpx;
  background: #FFF3DE;
  color: #A86D23;
  font-size: 22rpx;
  text-align: center;
}

.solid-food-preset.active {
  background: #E8A847;
  color: #fff;
}

.preview-title {
  font-size: 28rpx;
  color: #2E8753;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.preview-content {
  font-size: 30rpx;
  color: #333;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
  margin-top: 20rpx;
}

.btn-danger::after {
  border: none;
}
.latest-feeding-tip {
  margin-bottom: 22rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF4DD;
  color: #9B641D;
  font-size: 24rpx;
  line-height: 1.5;
}

.solid-food-reused-tip {
  margin: 4rpx 0 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF6E5;
  color: #B7791F;
  font-size: 24rpx;
}
