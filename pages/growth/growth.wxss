page {
  background: #FBF8F2;
  color: #35463D;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
button::after {
  border: none;
}
.container {
  padding: 28rpx 30rpx 48rpx;
}
.card {
  box-sizing: border-box;
  border: 1rpx solid #EEEAE1;
  box-shadow: 0 4rpx 18rpx rgba(47, 67, 53, .035);
}
.page-intro {
  padding: 8rpx 4rpx 30rpx;
}
.page-title {
  font-size: 40rpx;
  line-height: 1.5;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.page-subtitle {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #69756B;
}
.section-title {
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #35463D;
}
.latest-card {
  padding: 30rpx;
  background: #EFF6EE;
  border-color: #DDEADB;
}
.latest-row {
  display: flex;
  margin: 28rpx 0;
}
.latest-item {
  flex: 1;
  min-width: 0;
  text-align: left;
  padding-left: 6rpx;
}
.latest-item + .latest-item {
  border-left: 1rpx solid #D4E2D2;
  padding-left: 32rpx;
}
.latest-label {
  color: #5F6E61;
  font-size: 26rpx;
}
.latest-value {
  margin-top: 6rpx;
  color: #285D49;
  font-size: 58rpx;
  line-height: 1.4;
  font-weight: 600;
}
.unit {
  font-size: 26rpx;
  font-weight: normal;
  color: #5F6E61;
}
.latest-change {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #5F6E61;
  line-height: 1.6;
}
.record-button {
  width: 100%;
  background: #2E6952;
  box-shadow: none;
  font-size: 29rpx;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 18rpx;
}
.section-heading {
  padding: 10rpx 4rpx 20rpx;
}
.section-caption {
  margin-top: 6rpx;
  color: #69756B;
  font-size: 25rpx;
  line-height: 1.6;
}
.chart-toggle {
  display: flex;
  padding: 8rpx;
  gap: 6rpx;
  margin-bottom: 16rpx;
  background: #ECEFE7;
  border-radius: 20rpx;
}
.toggle-item {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #5D6B60;
  background: transparent;
  border-radius: 15rpx;
}
.toggle-item.active {
  background: #FFF;
  color: #285D49;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(47, 67, 53, .06);
}
.chart-card {
  position: relative;
  padding: 20rpx;
  overflow: hidden;
}
canvas {
  display: block;
  max-width: 100%;
  margin: 0 auto;
}
.chart-overflow-tip {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F0E2;
  color: #70563C;
  font-size: 24rpx;
  line-height: 1.7;
}
.chart-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88%;
  transform: translate(-50%, -50%);
  color: #536258;
  font-size: 29rpx;
  line-height: 1.6;
  text-align: center;
}
.empty-symbol {
  margin: 0 auto 14rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  background: #EFF6EE;
  color: #2E6952;
  font-size: 38rpx;
}
.empty-sub {
  color: #69756B;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 8rpx;
}
.history-card {
  padding: 0;
  overflow: hidden;
}
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 24rpx 28rpx;
  text-align: left;
  line-height: 1.5;
  background: #FFF;
  border-radius: 24rpx;
}
.history-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.list-count {
  font-size: 23rpx;
  color: #69756B;
  background: #F2F3ED;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}
.history-toggle {
  font-size: 25rpx;
  color: #2E6952;
  white-space: nowrap;
}
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  min-height: 104rpx;
  border-top: 1rpx solid #EEEAE1;
}
.record-left {
  flex: 1;
  min-width: 0;
}
.record-date {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}
.record-note {
  margin-top: 7rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #69756B;
  word-break: break-all;
}
.record-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.tag {
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}
.weight-tag {
  background: #EDF5EC;
  color: #355E3D;
}
.height-tag {
  background: #EDF2F6;
  color: #49657D;
}
.record-arrow {
  color: #6C7A6F;
  font-size: 34rpx;
}
.empty-tip {
  padding: 38rpx 26rpx;
  color: #536258;
  font-size: 27rpx;
  line-height: 1.7;
}
.milestone-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  margin: 0 0 24rpx;
  padding: 30rpx 26rpx;
  text-align: left;
  line-height: 1.5;
  background: #FFF;
  white-space: normal;
}
.milestone-entry-icon {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  background: #F3F4E8;
  border-radius: 22rpx;
  font-size: 38rpx;
}
.milestone-entry-copy {
  flex: 1;
  min-width: 0;
}
.milestone-entry-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #35463D;
}
.milestone-entry-desc {
  margin-top: 7rpx;
  color: #69756B;
  font-size: 25rpx;
  line-height: 1.6;
}
.milestone-entry-ages {
  margin-top: 10rpx;
  color: #2E6952;
  font-size: 23rpx;
}
.milestone-entry-arrow {
  flex-shrink: 0;
  color: #2E6952;
  font-size: 40rpx;
}
