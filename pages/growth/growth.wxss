page {
  background: #FFFAF5;
  color: #4A4A4A;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
button::after {
  border: none;
}
.container {
  padding: 28rpx 30rpx 48rpx;
}
.card {
  box-sizing: border-box;
  border: 1rpx solid #E5F0E8;
  box-shadow: 0 4rpx 18rpx rgba(118, 195, 147, .035);
}
.page-intro {
  padding: 8rpx 4rpx 30rpx;
}
.page-title {
  font-size: 40rpx;
  line-height: 1.5;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.page-subtitle {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #888888;
}
.section-title {
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #4A4A4A;
}
.latest-card {
  padding: 30rpx;
  background: #DCEFE3;
  border-color: #BFE4CC;
}
.latest-row {
  display: flex;
  margin: 28rpx 0;
}
.latest-item {
  flex: 1;
  min-width: 0;
  text-align: left;
  padding-left: 6rpx;
}
.latest-item + .latest-item {
  border-left: 1rpx solid #CFECD9;
  padding-left: 32rpx;
}
.latest-label {
  color: #64806E;
  font-size: 26rpx;
}
.latest-value {
  margin-top: 6rpx;
  color: #2E8753;
  font-size: 58rpx;
  line-height: 1.4;
  font-weight: 600;
}
.unit {
  font-size: 26rpx;
  font-weight: normal;
  color: #64806E;
}
.latest-change {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #64806E;
  line-height: 1.6;
}
.record-button {
  width: 100%;
  background: #76C393;
  box-shadow: none;
  font-size: 29rpx;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 18rpx;
}
.section-heading {
  padding: 10rpx 4rpx 20rpx;
}
.section-caption {
  margin-top: 6rpx;
  color: #888888;
  font-size: 25rpx;
  line-height: 1.6;
}
.chart-toggle {
  display: flex;
  padding: 8rpx;
  gap: 6rpx;
  margin-bottom: 16rpx;
  background: #F2FAF5;
  border-radius: 20rpx;
}
.toggle-item {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #5D6B60;
  background: transparent;
  border-radius: 15rpx;
}
.toggle-item.active {
  background: #76C393;
  color: #FFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(118, 195, 147, .06);
}
.chart-card {
  position: relative;
  padding: 28rpx 24rpx 24rpx;
  overflow: hidden;
}
.chart-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx 26rpx;
}
.chart-title {
  color: #35463D;
  font-size: 30rpx;
  font-weight: 600;
}
.chart-standard {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #F2F7F3;
  color: #64806E;
  font-size: 22rpx;
  white-space: nowrap;
}
.chart-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 16rpx 20rpx;
  padding-top: 22rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #EDF1ED;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #7B8981;
  font-size: 22rpx;
  white-space: nowrap;
}
.legend-line {
  width: 30rpx;
  height: 0;
  border-top: 5rpx solid #2E8753;
  border-radius: 4rpx;
}
.median-line {
  border-top: 3rpx dashed #76C393;
  border-radius: 0;
}
.legend-band {
  width: 24rpx;
  height: 16rpx;
  border: 1rpx solid #BFE4CC;
  border-radius: 4rpx;
  background: rgba(118, 195, 147, .12);
}
.height-chart .legend-line {
  border-color: #2D72BF;
}
.height-chart .median-line {
  border-color: #7DBBE8;
}
.height-chart .legend-band {
  border-color: #C7E2FF;
  background: rgba(125, 187, 232, .12);
}
.chart-hint {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #F4F8F4;
  color: #7B8981;
  font-size: 23rpx;
  line-height: 1.7;
}
canvas {
  display: block;
  max-width: 100%;
  margin: 0 auto;
}
.chart-overflow-tip {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF3D6;
  color: #70563C;
  font-size: 24rpx;
  line-height: 1.7;
}
.chart-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88%;
  transform: translate(-50%, -50%);
  color: #536258;
  font-size: 29rpx;
  line-height: 1.6;
  text-align: center;
}
.empty-symbol {
  margin: 0 auto 14rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  background: #DCEFE3;
  color: #2E8753;
  font-size: 38rpx;
}
.empty-sub {
  color: #888888;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 8rpx;
}
.history-card {
  padding: 0;
  overflow: hidden;
}
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 24rpx 28rpx;
  text-align: left;
  line-height: 1.5;
  background: #FFF;
  border-radius: 24rpx;
}
.history-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.list-count {
  font-size: 23rpx;
  color: #888888;
  background: #F2FAF5;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}
.history-toggle {
  font-size: 25rpx;
  color: #2E8753;
  white-space: nowrap;
}
.history-more {
  margin: 0;
  padding: 24rpx;
  background: #F2FAF5;
  color: #2E8753;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 0;
}
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  min-height: 104rpx;
  border-top: 1rpx solid #E5F0E8;
}
.record-left {
  flex: 1;
  min-width: 0;
}
.record-date {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}
.record-note {
  margin-top: 7rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #888888;
  word-break: break-all;
}
.record-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.tag {
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}
.weight-tag {
  background: #CFECD9;
  color: #2E8753;
}
.height-tag {
  background: #C7E2FF;
  color: #2D72BF;
}
.record-arrow {
  color: #6C7A6F;
  font-size: 34rpx;
}
.empty-tip {
  padding: 38rpx 26rpx;
  color: #536258;
  font-size: 27rpx;
  line-height: 1.7;
}
.milestone-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  margin: 0 0 24rpx;
  padding: 30rpx 26rpx;
  text-align: left;
  line-height: 1.5;
  background: #FFF;
  white-space: normal;
}
.milestone-entry-icon {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  background: #CFECD9;
  border-radius: 22rpx;
  font-size: 38rpx;
}
.milestone-entry-copy {
  flex: 1;
  min-width: 0;
}
.milestone-entry-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #4A4A4A;
}
.milestone-entry-desc {
  margin-top: 7rpx;
  color: #888888;
  font-size: 25rpx;
  line-height: 1.6;
}
.milestone-entry-ages {
  margin-top: 10rpx;
  color: #2E8753;
  font-size: 23rpx;
}
.milestone-entry-arrow {
  flex-shrink: 0;
  color: #2E8753;
  font-size: 40rpx;
}

.latest-percentile {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #5A8F70;
}
