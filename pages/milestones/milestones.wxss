page {
  background: #FBF8F2;
  color: #35463D;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
button {
  font-family: inherit;
}
button::after {
  border: none;
}
.container {
  padding: 26rpx 30rpx 48rpx;
}
.card {
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid #EEEAE1;
  box-shadow: 0 4rpx 18rpx rgba(47, 67, 53, .035);
}
.intro-card {
  background: #EFF6EE;
  border-color: #DDEADB;
  margin-bottom: 22rpx;
}
.intro-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx;
}
.intro-mark {
  color: #426B50;
  font-size: 24rpx;
}
.age-pill {
  padding: 5rpx 14rpx;
  border-radius: 24rpx;
  background: #FFF;
  color: #426B50;
  font-size: 23rpx;
}
.page-title {
  margin-top: 20rpx;
  font-size: 41rpx;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.intro-text {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: #5F6E61;
}
.month-tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid #E7EADF;
  border-radius: 22rpx;
  background: #F0F2EB;
}
.month-tab {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  margin: 0;
  padding: 14rpx 6rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: transparent;
  color: #5F6E61;
  line-height: 1.5;
}
.month-tab.active {
  color: #285D49;
  background: #FFF;
  border-color: #DCE7D8;
  box-shadow: 0 2rpx 8rpx rgba(47, 67, 53, .05);
}
.month-label {
  font-size: 32rpx;
  font-weight: 600;
}
.month-caption {
  font-size: 22rpx;
  margin-top: 3rpx;
}
.stage-hint {
  padding: 20rpx 4rpx 28rpx;
  color: #647165;
  font-size: 25rpx;
  line-height: 1.7;
}
.section-title {
  color: #35463D;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}
.record-summary {
  margin: 0 4rpx 22rpx;
}
.summary-number {
  color: #285D49;
  font-size: 37rpx;
}
.summary-hint {
  margin-top: 4rpx;
  color: #69756B;
  font-size: 25rpx;
  line-height: 1.6;
}
.group-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 18rpx;
}
.group-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 132rpx;
  margin: 0;
  padding: 24rpx 26rpx;
  text-align: left;
  line-height: 1.5;
  background: #FFF;
  border-radius: 24rpx;
}
.group-icon {
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 20rpx;
  text-align: center;
  background: #F7EDE5;
  color: #926B50;
  font-size: 38rpx;
}
.group-icon.language {
  background: #EDF3E8;
  color: #587346;
}
.group-icon.cognitive {
  background: #F5F0DF;
  color: #8D743A;
}
.group-icon.motor {
  background: #EBF1F5;
  color: #527388;
}
.group-heading-copy {
  flex: 1;
  min-width: 0;
}
.group-title {
  color: #35463D;
  font-size: 30rpx;
  font-weight: 600;
}
.group-count {
  margin-top: 5rpx;
  font-size: 23rpx;
  color: #69756B;
}
.group-toggle {
  font-size: 24rpx;
  color: #2E6952;
  white-space: nowrap;
}
.group-body {
  padding: 0 26rpx;
  border-top: 1rpx solid #F0EDE6;
}
.milestone-item {
  display: block;
  width: 100%;
  margin: 0;
  padding: 26rpx 0 20rpx;
  text-align: left;
  line-height: 1.6;
  background: #FFF;
  border-radius: 0;
  border-bottom: 1rpx solid #EEEAE1;
  white-space: normal;
  overflow: visible;
}
.milestone-item:last-child {
  border-bottom: none;
}
.item-heading {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.item-title {
  flex: 1;
  min-width: 0;
  color: #35463D;
  font-size: 29rpx;
  line-height: 1.6;
  font-weight: 500;
}
.status-tag {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: #F1F2ED;
  color: #657061;
  font-size: 23rpx;
  line-height: 1.6;
  white-space: nowrap;
}
.status-tag.yes {
  color: #315D42;
  background: #EAF3E8;
}
.status-tag.notYet {
  color: #826440;
  background: #F7F0E2;
}
.status-tag.unsure {
  color: #4A687B;
  background: #EDF2F6;
}
.item-tip {
  color: #647165;
  font-size: 26rpx;
  line-height: 1.75;
}
.observation-date {
  margin-top: 12rpx;
  color: #69756B;
  font-size: 23rpx;
  line-height: 1.6;
}
.observation-note {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #F8F7F2;
  color: #566154;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.item-action {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #2E6952;
  font-size: 25rpx;
}
.item-action text {
  font-size: 30rpx;
  line-height: 1.4;
}
.activity-card {
  margin-top: 28rpx;
  background: #F2F6EE;
  border-color: #E1E8D9;
}
.activity-intro {
  margin-top: 10rpx;
}
.activity-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #DFE7D8;
}
.activity-reason {
  margin: 10rpx 0;
  color: #466B50;
  font-size: 25rpx;
  line-height: 1.7;
}
.observe-button {
  width: 100%;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 12rpx;
  line-height: 1.7;
  border: 1rpx solid #BFD2B8;
  border-radius: 16rpx;
  background: #FFF;
  color: #285D49;
  font-size: 27rpx;
}
.summary-card {
  margin-top: 24rpx;
}
.summary-card .item-tip {
  margin-top: 8rpx;
}
.summary-button, .retry-button {
  width: 100%;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 12rpx;
  border: 1rpx solid #CFDCCD;
  border-radius: 16rpx;
  line-height: 1.7;
  color: #285D49;
  background: #F8FAF6;
  font-size: 27rpx;
}
.reference-card {
  padding: 12rpx 8rpx;
  color: #647165;
  font-size: 24rpx;
  line-height: 1.8;
}
.reference-title {
  margin-bottom: 10rpx;
  color: #536258;
  font-size: 26rpx;
  font-weight: 600;
}
.reference-note {
  margin-top: 12rpx;
}
.source-button {
  min-height: 88rpx;
  margin: 12rpx 0 0;
  padding: 18rpx 0;
  color: #2E6952;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.8;
  text-align: left;
  white-space: normal;
}
.state-card {
  color: #647165;
  font-size: 27rpx;
  line-height: 1.8;
}
.state-card .item-tip {
  margin-top: 12rpx;
}
.editor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(27, 39, 31, .38);
}
.editor-panel {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 32rpx);
  padding: 20rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FBF8F2;
}
.editor-handle {
  flex-shrink: 0;
  width: 68rpx;
  height: 8rpx;
  margin: 0 auto 8rpx;
  border-radius: 8rpx;
  background: #D9DED3;
}
.editor-header {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
}
.editor-caption {
  color: #647165;
  font-size: 25rpx;
}
.close-button {
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #2E6952;
  font-size: 26rpx;
  line-height: 88rpx;
}
.editor-scroll {
  height: 58vh;
  min-height: 0;
  flex-shrink: 1;
}
.editor-title {
  margin: 8rpx 0 12rpx;
  color: #35463D;
  font-size: 35rpx;
  font-weight: 600;
  line-height: 1.5;
}
.field-label {
  margin: 28rpx 0 14rpx;
  color: #35463D;
  font-size: 28rpx;
  font-weight: 500;
}
.status-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.status-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 20rpx 22rpx;
  border: 2rpx solid #E3E5DB;
  border-radius: 18rpx;
  background: #FFF;
  text-align: left;
  line-height: 1.5;
  white-space: normal;
}
.status-option.selected {
  border-color: #2E6952;
  background: #EFF5EB;
}
.choice-copy {
  flex: 1;
  min-width: 0;
}
.choice-title {
  color: #35463D;
  font-size: 29rpx;
  font-weight: 500;
}
.choice-description {
  margin-top: 5rpx;
  color: #647165;
  font-size: 24rpx;
  line-height: 1.7;
}
.choice-check {
  flex-shrink: 0;
  color: #647165;
  font-size: 23rpx;
}
.selected .choice-check {
  color: #285D49;
  font-weight: 600;
}
.date-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  min-height: 94rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E3E5DB;
  border-radius: 16rpx;
  background: #FFF;
  color: #35463D;
  font-size: 28rpx;
}
.date-edit {
  color: #2E6952;
  font-size: 25rpx;
}
.optional-label {
  margin-left: 10rpx;
  color: #69756B;
  font-size: 24rpx;
  font-weight: normal;
}
.note-input {
  box-sizing: border-box;
  width: 100%;
  height: 176rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E3E5DB;
  border-radius: 16rpx;
  background: #FFF;
  color: #35463D;
  font-size: 27rpx;
  line-height: 1.7;
}
.note-limit {
  margin-top: 8rpx;
  text-align: right;
  color: #69756B;
  font-size: 23rpx;
}
.editor-actions {
  flex-shrink: 0;
  padding-top: 22rpx;
}
.save-button {
  width: 100%;
  height: 96rpx;
  margin: 0;
  border-radius: 18rpx;
  background: #2E6952;
  color: #FFF;
  font-size: 30rpx;
  line-height: 96rpx;
  box-shadow: none;
}
.save-button[disabled] {
  background: #E1E7DD;
  color: #69756B;
}