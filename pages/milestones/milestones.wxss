.intro-card {
  background: #EAF8EF;
}
.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2E8753;
}
.age-text {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #527761;
}
.intro-text, .stage-hint, .item-tip, .reference-card {
  font-size: 26rpx;
  line-height: 1.7;
  color: #777;
}
.intro-text {
  margin-top: 14rpx;
}
.month-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #fff;
}
.month-tab {
  flex: 1;
  margin: 0;
  border-radius: 18rpx;
  background: #fff;
  color: #888;
  font-size: 28rpx;
}
.month-tab.active {
  background: #5BC58F;
  color: #fff;
  font-weight: 600;
}
button::after {
  border: none;
}
.stage-hint {
  padding: 18rpx 6rpx;
}
.record-summary {
  margin: 0 6rpx 20rpx;
  font-size: 25rpx;
  color: #8D8176;
}
.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E8753;
  margin-bottom: 8rpx;
}
.milestone-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F0EBE5;
}
.milestone-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.item-heading {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.item-title {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.5;
}
.status-tag {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  font-size: 23rpx;
  border-radius: 12rpx;
  background: #F3F0EC;
  color: #8D8176;
}
.status-tag.yes {
  background: #E5F6EB;
  color: #2E8753;
}
.status-tag.notYet {
  background: #FFF3DD;
  color: #896B32;
}
.status-tag.unsure {
  background: #EBF3FC;
  color: #527499;
}
.observation-date {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #999;
}
.observation-note {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  color: #665D53;
}
.reference-note {
  margin-top: 14rpx;
}
.source-button {
  margin: 20rpx 0 0;
  font-size: 25rpx;
  color: #2E8753;
  background: #F0F8F3;
}
.editor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, .38);
  display: flex;
  align-items: flex-end;
}
.editor-panel {
  width: 100%;
  box-sizing: border-box;
  background: #FFFAF5;
  border-radius: 30rpx 30rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.editor-scroll {
  height: 62vh;
}
.editor-title {
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}
.status-option {
  flex: 1;
  min-width: 170rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 26rpx;
  background: #fff;
  color: #777;
  border: 2rpx solid #E9E3DC;
  border-radius: 16rpx;
}
.status-option.selected {
  background: #EAF8EF;
  color: #2E8753;
  border-color: #5BC58F;
}
.date-field {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
}
.date-field text {
  color: #2E8753;
}
.note-input {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  font-size: 28rpx;
}
.note-limit {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.cancel-button {
  flex: 1;
  margin: 0;
  height: 92rpx;
  line-height: 92rpx;
  background: #F0EBE5;
  color: #777;
  font-size: 30rpx;
  border-radius: 20rpx;
}
.save-button {
  flex: 2;
  margin: 0;
}
.summary-button {
  margin: 0 0 24rpx;
  font-size: 26rpx;
  color: #2E8753;
  background: #EAF8EF;
  border-radius: 18rpx;
}
.activity-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E0EEDC;
}
.activity-reason {
  margin: 10rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
  color: #527761;
}
.observe-button {
  margin: 18rpx 0 0;
  background: #fff;
  color: #2E8753;
  font-size: 26rpx;
  border: 1rpx solid #C6EDD4;
  border-radius: 16rpx;
}
.activity-card {
  background: #F2F9F4;
}
.choice-help {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #888;
}
