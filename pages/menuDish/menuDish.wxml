<view class="container" wx:if="{{dish}}">
  <view class="card dish-hero">
    <view class="dish-art" style="background: {{dish.color}};">{{dish.imageEmoji}}</view>
    <view class="dish-title-wrap">
      <input class="dish-title-input" value="{{dish.name}}" bindinput="bindNameInput" placeholder="{{isNewCustom ? '给这道菜起个名字' : ''}}" />
      <view class="dish-sub">{{mealLabel}} · {{dish.ageMinMonth}}-{{dish.ageMaxMonth}} 月龄</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">营养标签</view>
    <view class="tag-wrap">
      <text class="nutrition-tag" wx:for="{{dish.nutritionTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{dish.servingLabel}}">
    <view class="section-title">建议量</view>
    <view class="serving-text">{{dish.servingLabel}}</view>
  </view>

  <view class="card form-card">
    <view class="form-label">性状</view>
    <input class="text-input" value="{{dish.texture}}" bindinput="bindTextureInput" placeholder="如：细腻泥糊" />

    <view class="form-label">食材</view>
    <view class="form-hint" wx:if="{{dish.isCustom}}">每行一种，写食材名（如 胡萝卜、土豆）；首页录这道菜时会按这里自动记试吃</view>
    <textarea value="{{ingredientsText}}" bindinput="bindIngredientsInput" auto-height maxlength="-1" placeholder="每行一种食材" />

    <view class="form-label">做法</view>
    <textarea value="{{stepsText}}" bindinput="bindStepsInput" auto-height maxlength="-1" />

    <view class="form-label">注意点</view>
    <textarea value="{{cautionsText}}" bindinput="bindCautionsInput" auto-height maxlength="-1" />
  </view>

  <button class="btn-primary" bindtap="saveDish">保存修改</button>
</view>
